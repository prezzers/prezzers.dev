---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">Software engineer · Degree apprentice</p>
			<h1>Hi, I'm Presley.</h1>
			<p class="lead">
				I build web apps end to end, from the interface to the infrastructure, and run my own
				homelab to host them.
			</p>
			<p class="muted">
				This is where I write about what I'm building and learning: web development, self-hosting,
				and the bugs that taught me the most.
			</p>
			<div class="actions">
				<a class="btn primary" href="/blog">Read the writing</a>
				<a class="btn" href={GITHUB_URL} target="_blank" rel="noopener">GitHub ↗</a>
			</div>

			<div class="section-label">Writing</div>
			{
				posts.length === 0 ? (
					<p class="muted">First posts coming soon.</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="post-title">{post.data.title}</span>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))}
					</ul>
				)
			}

			<div class="section-label">Projects</div>
			<a class="card" href="/projects#coredump">
				<h3>CoreDump</h3>
				<p>My all-in-one place for ideas, notes, tasks and uni work, with AI to keep it organised.</p>
				<ul class="tags"><li>Next.js</li><li>Postgres</li><li>AI</li></ul>
			</a>
			<a class="card" href="/projects#homelab">
				<h3>Homelab</h3>
				<p>An old gaming laptop running my apps, ad blocking and deployments, with no open ports.</p>
				<ul class="tags"><li>Proxmox</li><li>Docker</li><li>Coolify</li><li>Cloudflare</li></ul>
			</a>
		</main>
		<Footer />
	</body>
</html>

<style>
	.lead {
		font-size: 1.22rem;
		line-height: 1.6;
		letter-spacing: -0.01em;
		margin-top: 1.25rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.55rem 1rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 500;
		text-decoration: none;
		background: var(--surface);
	}
	.btn:hover {
		border-color: var(--accent);
	}
	.btn.primary {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--bg);
	}
	.btn.primary:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
</style>
