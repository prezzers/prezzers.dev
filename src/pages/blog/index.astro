---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing · ${SITE_TITLE}`} description="Posts by Presley Dobson." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Writing</h1>
			<p class="muted">Notes on building software, running a homelab, and what broke along the way.</p>
			<div class="section-label">All posts</div>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="post-title">
									{post.data.title}
									<span class="post-desc">{post.data.description}</span>
								</span>
								<FormattedDate date={post.data.pubDate} />
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
