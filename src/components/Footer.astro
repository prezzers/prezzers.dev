---
import { GITHUB_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<span>&copy; {year} Presley Dobson</span>
		<span class="right">
			<span class="status"><span class="dot" aria-hidden="true"></span>Self-hosted on my homelab</span>
			<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
			<a href="/rss.xml">RSS</a>
		</span>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--line);
	}
	.inner {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 1.75rem 1.5rem 3rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--muted);
	}
	.right {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}
	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
	}
</style>
